# Versioned docs: assets with the same group are one product. Each covers AVS from
# its `since` version up to the next asset's `since`. New releases need no change
# here unless they get their own docs.
[asset "Advanced Vehicle System"]
id = AVS
group = AVS
since = 1.5
dir = AdvancedVehicleSystem
default = README.md

file "Home" -> README.md
link "FAB Listing" -> https://www.fab.com/listings/e1457ad1-297b-4a70-aecb-5c6716d9494f
link "Vehicle Quick Reference" -> https://docs.google.com/spreadsheets/d/1pkKlGzj8sBwvM5CaRuJEFr3M6ok60kjFWUP30DUFpR8

dir "Getting Started" -> Getting_Started recursive
dir "Configuration" -> Configuration recursive
dir "Components" -> Components recursive
dir "Wheel Effects" -> Wheel_Effects recursive
dir "Skeletal Mesh" -> Skeletal_Mesh recursive
dir "Guides" -> Guides recursive
dir "Advanced" -> Advanced recursive
dir "Reference" -> Reference recursive

[asset "Advanced Vehicle System (Legacy)"]
id = AVS_Legacy
group = AVS
since = 1.2
dir = AdvancedVehicleSystem_Legacy
default = README.md

file "Home" -> README.md
link "FAB Listing" -> https://www.fab.com/listings/e1457ad1-297b-4a70-aecb-5c6716d9494f
link "Vehicle Quick Reference" -> https://docs.google.com/spreadsheets/d/1pkKlGzj8sBwvM5CaRuJEFr3M6ok60kjFWUP30DUFpR8

dir "General" -> General recursive
dir "Components" -> Components recursive
dir "Tutorials" -> Tutorials nonrecursive
dir "Skeletal Mesh" -> Tutorials/Skeletal_Mesh recursive

[asset "Traffic Control System"]
id = TCS
dir = TrafficControlSystem
default = Home.md
file "Home" -> Home.md